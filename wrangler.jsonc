{
  // Configuración del Worker de SilveraCalm en Cloudflare
  "name": "silveracalm",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",

  // La landing: todos los archivos de la raíz del repo
  // (los que no deben publicarse están en .assetsignore)
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },

  // Workers AI: la IA gratis de Cloudflare (10,000 "neurons" al día)
  "ai": {
    "binding": "AI"
  },

  // Para ver los logs del chatbot en el panel de Cloudflare
  "observability": {
    "enabled": true
  }
}
